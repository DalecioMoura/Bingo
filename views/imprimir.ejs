<!DOCTYPE html>
<html>
<head>
    <title>Bingo - Impressão</title>
    <style>
        body { font-family: Arial; text-align: center; margin: 0; padding: 10px; }
        .pagina { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; max-width: 800px; margin: auto; }
        .cartela { border: 2px dashed #000; padding: 10px; background: #fff; }
        table { width: 100%; border-collapse: collapse; }
        th { background: #333; color: #fff; font-size: 20px; padding: 5px; }
        td { border: 1px solid #000; height: 45px; width: 20%; font-size: 18px; font-weight: bold; }
        .free { font-size: 10px; background: #eee; }
        .controles { margin-bottom: 20px; }
        button { padding: 10px 20px; cursor: pointer; background: #28a745; color: white; border: none; border-radius: 5px; }
        @media print { .controles { display: none; } .cartela { border: 1px dashed #ccc; } }
    </style>
</head>
<body>
    <div class="controles">
        <button onclick="window.location.reload()">GERAR NOVAS CARTELAS</button>
        <button onclick="window.print()" style="background: #007bff;">IMPRIMIR PÁGINA</button>
        <a href="/sorteio"><button style="background: #6c757d;">IR PARA O SORTEIO</button></a>
    </div>

    <div class="pagina">
        <% cartelas.forEach(cartela => { %>
            <div class="cartela">
                <table>
                    <tr><th>B</th><th>I</th><th>N</th><th>G</th><th>O</th></tr>
                    <% for(let i=0; i<5; i++) { %>
                        <tr>
                            <td><%= cartela.B[i] %></td>
                            <td><%= cartela.I[i] %></td>
                            <td class="<%= i===2 ? 'free' : '' %>"><%= i===2 ? 'LIVRE' : cartela.N[i] %></td>
                            <td><%= cartela.G[i] %></td>
                            <td><%= cartela.O[i] %></td>
                        </tr>
                    <% } %>
                </table>
            </div>
        <% }) %>
    </div>
</body>
</html>