<!DOCTYPE html>
<html>
<head>
    <title>Sorteador de Bingo Profissional</title>
    <style>
        body { font-family: Arial, sans-serif; text-align: center; background: #1a1a1a; color: white; margin: 0; padding: 20px; }
        .main-container { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 20px; }
        #numero-grande { font-size: 150px; color: #f1c40f; line-height: 1; margin: 10px 0; }
        .historico { display: grid; grid-template-columns: repeat(15, 1fr); gap: 5px; background: #333; padding: 15px; border-radius: 10px; }
        .bola { width: 35px; height: 35px; background: #444; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; color: #888; border: 1px solid #555; }
        .sorteada { background: #27ae60; color: white; border-color: #fff; transform: scale(1.1); font-weight: bold; }
        .controles { margin-top: 20px; }
        button { padding: 15px 30px; font-size: 18px; cursor: pointer; border: none; border-radius: 8px; font-weight: bold; margin: 5px; }
        .btn-sortear { background: #e67e22; color: white; }
        .btn-reset { background: #c0392b; color: white; font-size: 14px; }
    </style>
</head>
<body>
    <h1>SORTEADOR BINGO 75</h1>
    
    <div class="main-container">
        <div>
            <div id="numero-grande">--</div>
            <div class="controles">
                <button class="btn-sortear" onclick="sortear()">SORTEAR PEDRA!</button>
                <br>
                <button class="btn-reset" onclick="reiniciar()">REINICIAR JOGO</button>
            </div>
        </div>

        <div>
            <h3>Quadro de Chamada</h3>
            <div class="historico" id="quadro"></div>
        </div>
    </div>

    <script>
        // Carrega números do sessionStorage ou inicia vazio
        let sorteados = JSON.parse(sessionStorage.getItem('bingo_v1')) || [];
        const quadro = document.getElementById('quadro');

        function atualizarQuadro() {
            quadro.innerHTML = '';
            for(let i=1; i<=75; i++) {
                const div = document.createElement('div');
                div.className = 'bola' + (sorteados.includes(i) ? ' sorteada' : '');
                div.innerText = i;
                quadro.appendChild(div);
            }
            if(sorteados.length > 0) {
                document.getElementById('numero-grande').innerText = sorteados[sorteados.length - 1];
            }
        }

        function sortear() {
            if(sorteados.length >= 75) return alert("Fim do jogo!");
            
            let num;
            do {
                num = Math.floor(Math.random() * 75) + 1;
            } while(sorteados.includes(num));

            sorteados.push(num);
            sessionStorage.setItem('bingo_v1', JSON.stringify(sorteados));
            atualizarQuadro();
        }

        function reiniciar() {
            if(confirm("Deseja realmente zerar o jogo e limpar o histórico?")) {
                sessionStorage.removeItem('bingo_v1');
                sorteados = [];
                document.getElementById('numero-grande').innerText = '--';
                atualizarQuadro();
            }
        }

        // Inicializa o quadro ao carregar a página
        atualizarQuadro();
    </script>
</body>
</html>